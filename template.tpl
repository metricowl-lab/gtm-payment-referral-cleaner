___TESTS___

scenarios:
- name: Ordinary referrers return nothing
  code: |-
    mock('getReferrerUrl', 'https://www.google.com/search?q=x');
    assertThat(runCode({})).isUndefined();
- name: Klarna, PayPal and Clearpay return true
  code: |-
    mock('getReferrerUrl', 'https://pay.klarna.com/eu/hpp/payments/abc');
    assertThat(runCode({})).isTrue();
    mock('getReferrerUrl', 'https://www.paypal.com/checkoutnow?token=1');
    assertThat(runCode({})).isTrue();
    mock('getReferrerUrl', 'https://portal.clearpay.co.uk/uk/checkout');
    assertThat(runCode({})).isTrue();
- name: No referrer returns nothing
  code: |-
    mock('getReferrerUrl', '');
    assertThat(runCode({})).isUndefined();
- name: Bank pages only when the setting is on
  code: |-
    mock('getReferrerUrl', 'https://acs2.bank.example/3ds/challenge');
    assertThat(runCode({matchBankPages: false})).isUndefined();
    assertThat(runCode({matchBankPages: true})).isTrue();
- name: Extra domains, as domains or full addresses
  code: |-
    mock('getReferrerUrl', 'https://checkout.payments.example/return');
    assertThat(runCode({extraDomains: 'www.payments.example'})).isTrue();
    assertThat(runCode({extraDomains: ' https://payments.example/pay \r\nother.example'})).isTrue();
- name: Look-alikes don't match
  code: |-
    mock('getReferrerUrl', 'https://notpaypal.com/');
    assertThat(runCode({})).isUndefined();
    mock('getReferrerUrl', 'https://paypal.com.example.net/');
    assertThat(runCode({})).isUndefined();
- name: Referrer override is used
  code: |-
    mock('getReferrerUrl', 'https://www.google.com/');
    assertThat(runCode({referrerOverride: 'https://checkout.stripe.com/c/pay'})).isTrue();


