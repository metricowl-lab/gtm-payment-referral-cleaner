___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const getReferrerUrl = require('getReferrerUrl');
const parseUrl = require('parseUrl');
const makeString = require('makeString');

// The sandbox doesn't guarantee String.trim, so this removes spaces, tabs and carriage returns.
const trim = function (value) {
  const str = makeString(value);
  let start = 0;
  let end = str.length;
  while (start < end && ' \t\r'.indexOf(str.charAt(start)) > -1) start++;
  while (end > start && ' \t\r'.indexOf(str.charAt(end - 1)) > -1) end--;
  return str.slice(start, end);
};

// A full URL or a bare domain becomes a lowercase hostname without www.
const hostOf = function (value) {
  let v = trim(value || '').toLowerCase();
  if (!v) return '';
  if (v.indexOf('://') > -1) {
    const parsed = parseUrl(v);
    v = parsed ? parsed.hostname : '';
  }
  v = v.split('/')[0].split(':')[0];
  if (v.indexOf('www.') === 0) v = v.slice(4);
  return v;
};

// Payment and buy-now-pay-later domains that send customers back to the shop.
const DOMAINS = [
  'klarna.com', 'klarnaservices.com', 'clearpay.co.uk', 'afterpay.com', 'paypal.com', 'zip.co', 'laybuy.com',
  'stripe.com', 'checkout.com', 'adyen.com', 'worldpay.com', 'opayo.co.uk', 'sagepay.com',
  'braintreegateway.com', 'pay.google.com', 'mollie.com'
];
const extra = makeString(data.extraDomains || '').split('\n');
for (let i = 0; i < extra.length; i++) {
  const d = hostOf(extra[i]);
  if (d) DOMAINS.push(d);
}

const host = hostOf(data.referrerOverride || getReferrerUrl());
if (!host) return undefined;

let isPayment = false;
for (let i = 0; i < DOMAINS.length; i++) {
  const d = DOMAINS[i];
  if (host === d || host.slice(-(d.length + 1)) === '.' + d) { isPayment = true; break; }
}
// Bank verification (3-D Secure) pages, such as acs.bank.example or 3ds2.bank.example.
if (!isPayment && data.matchBankPages) {
  const first = host.split('.')[0];
  if (first.indexOf('acs') === 0 || first.indexOf('3ds') === 0) isPayment = true;
}

// true tells GA4 not to treat this page's referrer as a traffic source. Anything else: no value,
// so the ignore_referrer parameter isn't sent at all.
return isPayment ? true : undefined;


